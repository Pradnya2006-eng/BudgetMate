# Copy this file to ".env" (same folder) and fill in your own values.
# Never commit ".env": it holds your database password and secret key.

# --- MySQL -----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=budgetmate

# --- Sessions --------------------------------------------------------------
# Long random text that signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to true once the site is served over HTTPS.
COOKIE_SECURE=false

# --- Password-reset emails -------------------------------------------------
# Address of the React app. The reset link in the email points here.
FRONTEND_URL=http://localhost:5173

# Leave SMTP_HOST empty while developing: the reset link is then printed in
# this terminal instead of being emailed, which is handy for demos.
# For Gmail: smtp.gmail.com, port 587, and an "App password" (not your login).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=BudgetMate <no-reply@example.com>

# How long a reset link stays valid.
RESET_TOKEN_MINUTES=60
